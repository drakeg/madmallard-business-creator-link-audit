PORT=8042
BIND_ADDRESS=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-random-password
COOKIE_SECURE=false
DB_PATH=/data/audit.sqlite3
SCAN_CONCURRENCY=4
SCAN_TIMEOUT=10
SCAN_RETRIES=1
MAX_SOURCES=20
MAX_LINKS=100
LYCHEE_BIN=lychee

# Optional: independent key for public YouTube description imports (no account login)
YOUTUBE_API_KEY=
